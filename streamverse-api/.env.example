# StreamVerse API — environment configuration
# Copy to .env and fill in every value. NEVER commit .env. Values below are safe placeholders, not real secrets.
# Generate random secrets: openssl rand -base64 48

# ============================================================
# APP
# ============================================================
NODE_ENV=development                     # development | test | production
PORT=4000
# Number of reverse proxies in front of the API (1 behind nginx/load balancer, 0 for none).
TRUST_PROXY=0
LOG_LEVEL=info                           # fatal | error | warn | info | debug | trace | silent
# Swagger UI at /api/v1/docs. Defaults to on in development and off in production.
API_DOCS_ENABLED=true

# ============================================================
# DATABASE (MySQL 8.0+)
# ============================================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local development example — replace USER and PASSWORD with your MySQL credentials.
# Production: use a strong password; connect over a private network or TLS.
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/streamverse_dev

# ============================================================
# AUTH
# ============================================================
# Minimum 32 characters each; must differ from each other.
# Production: must NOT be "secret", "changeme", "dev-secret" or any placeholder.
JWT_SECRET=change-me-change-me-change-me-change-me-0001
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me-0002
# How long an access token (JWT) is valid. Short-lived on purpose; the refresh token renews it.
ACCESS_TOKEN_TTL=15m
# How long a refresh token / AuthSession row is valid before it must be used or is rejected.
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# "lax" works when frontend and API share a site (e.g. app.example.com / api.example.com, or localhost).
# Use "none" only on a fully separate site, and keep NODE_ENV=production so the cookie is also Secure.
AUTH_COOKIE_SAMESITE=lax

# --- Admin bootstrap (scripts/createAdmin.ts only; the running API never reads these) ----
ADMIN_EMAIL=admin@streamverse.local
ADMIN_PASSWORD=change-me-change-me-change-me
ADMIN_NAME=StreamVerse Admin

# ============================================================
# CORS
# ============================================================
FRONTEND_URL=http://localhost:5173
# Extra comma-separated origins allowed to call the API (no wildcards, no trailing slash, no path).
# FRONTEND_URL is always included. Example: http://localhost:5173,https://app.streamverse.io
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180
# Production example: ALLOWED_ORIGINS=https://streamverse.com,https://www.streamverse.com
# NOTE: wildcard (*) is explicitly rejected. This API uses Bearer tokens (not cookies) for auth,
# so CSRF is not a concern; strict-origin CORS is still enforced to prevent cross-site data reads.

# ============================================================
# STORAGE (S3-compatible object storage)
# ============================================================
# STORAGE_PROVIDER=local uses the filesystem dev adapter (LOCAL_STORAGE_DIR) and needs nothing else.
# s3/r2/b2/spaces all speak the S3 API. Set AWS_ENDPOINT for anything but AWS itself.
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=
LOCAL_STORAGE_DIR=./.data/media
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=600
MEDIA_CLEANUP_GRACE_SECONDS=86400
# Optional public CDN base URL for assets served publicly. Falls back to signed URL when unset.
MEDIA_BASE_URL=

# ============================================================
# REDIS
# ============================================================
# QUEUE_DRIVER=inline runs jobs in-process (dev/test). "bullmq" uses Redis via REDIS_URL.
QUEUE_DRIVER=inline
REDIS_URL=

# ============================================================
# STRIPE (Phase 7)
# ============================================================
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET: from `stripe listen --print-secret` (local) or the Stripe dashboard endpoint.
# Production: STRIPE_SECRET_KEY must start with sk_live_ (enforced at startup).
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/billing

# ============================================================
# EMAIL
# ============================================================
# "console" logs emails to stdout (development default).
# "resend" sends real emails via Resend — set RESEND_API_KEY.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@streamverse.com
RESEND_API_KEY=
APP_PUBLIC_URL=http://localhost:5173
# APP_PUBLIC_URL=https://streamverse.com  # production

# ============================================================
# MEDIA / VIDEO PROCESSING (Phase 6)
# ============================================================
# Only needed if ffmpeg/ffprobe are not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# ============================================================
# MONITORING (Sentry) — leave empty to disable; app runs fine without it
# ============================================================
# Get DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Frontend Sentry project (separate project recommended; passed to Vite as VITE_SENTRY_DSN)
# VITE_SENTRY_DSN=

# ============================================================
# ALERT THRESHOLDS (informational — not enforced at runtime yet)
# ============================================================
# 5xx rate at which you want a warning / critical alert (configure in Sentry dashboard)
ERROR_RATE_WARNING_PERCENT=2
ERROR_RATE_CRITICAL_PERCENT=5
# Requests slower than this threshold (ms) are logged as WARN
SLOW_REQUEST_THRESHOLD_MS=3000
# Seconds without a heartbeat before a worker is considered dead
WORKER_HEARTBEAT_TIMEOUT_SECONDS=300
# Queue backlog sizes triggering warning / critical alerts
QUEUE_BACKLOG_WARNING=50
QUEUE_BACKLOG_CRITICAL=200

# ============================================================
# OBSERVABILITY / ENTITLEMENT / ANALYTICS
# ============================================================
# Days PAST_DUE before access is cut off. 0 = deny immediately (safe default).
SUBSCRIPTION_PAST_DUE_GRACE_DAYS=0
# Seconds an entitlement decision is cached per (user, content, type). 0 = disabled.
ENTITLEMENT_CACHE_TTL_SECONDS=60
# Seconds expensive analytics queries are cached. 0 = disabled.
ANALYTICS_CACHE_TTL_SECONDS=30
# Seconds without a heartbeat before a playback session is considered stale/expired (default: 120)
PLAYBACK_SESSION_TIMEOUT_SECONDS=120
