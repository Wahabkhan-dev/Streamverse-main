# StreamVerse frontend environment variables
# Copy to .env.local and fill in values for your environment

# ── Mode ──────────────────────────────────────────────────────────────────────
# Set to "false" to use the real backend API.
# Anything else (including the default "true") uses localStorage demo mode.
VITE_DEMO_MODE=true

# ── Backend ───────────────────────────────────────────────────────────────────
# Base URL for the StreamVerse API. No trailing slash.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ── Stripe (publishable key only — NEVER put the secret key here) ─────────────
# Required when VITE_DEMO_MODE=false and you want the real Stripe checkout flow.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Frontend Sentry (leave empty to disable) ──────────────────────────────────
# VITE_SENTRY_DSN=
# VITE_APP_VERSION=
